; Engine configuration file
; PROTOCOLO: PIZZA — Godot production base 0.2
config_version=5

[application]
config/name="PROTOCOLO: PIZZA"
config/description="Aventura point-and-click corporativa na PAPO SAPÃO"
run/main_scene="res://scenes/Main.tscn"

[autoload]
GameState="*res://scripts/game_state.gd"
AchievementManager="*res://scripts/achievement_manager.gd"
EndingManager="*res://scripts/ending_manager.gd"
SettingsManager="*res://scripts/settings_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
SceneRouter="*res://scripts/scene_router.gd"
GameFlow="*res://scripts/game_flow.gd"
DebugTools="*res://scripts/debug_tools.gd"
UIPolish="*res://scripts/ui_polish.gd"
MusicManager="*res://scripts/music_manager.gd"
DialogueUI="*res://scripts/dialogue_ui.gd"
SubareaManager="*res://scripts/subarea_manager.gd"
AchievementsUI="*res://scripts/achievements_ui.gd"
PlayerController="*res://scripts/player_controller.gd"
FloorInputFix="*res://scripts/floor_input_fix.gd"
InteractionGuard="*res://scripts/interaction_guard.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

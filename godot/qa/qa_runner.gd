func persistence_checks() -> void:
	await fresh()
	PlayerController._image_position=Vector2(450,700)
	check("save_written",SaveManager.save_slot(95))
	PlayerController._image_position=Vector2(800,850)
	check("load_accepted",SaveManager.load_slot(95))
	await frames()
	check("position_restored",PlayerController._image_position.distance_to(Vector2(450,700))<0.01)
	GameState.set_flag("backup_marker","first")
	SaveManager.save_slot(95)
	GameState.set_flag("backup_marker","second")
	SaveManager.save_slot(95)
	var file: FileAccess = FileAccess.open("user://save_95.json",FileAccess.WRITE)
	file.store_string("{truncated")
	file.close()
	check("backup_recovers",SaveManager.load_slot(95) and GameState.flags.get("backup_marker")=="first")
	await frames()
	var valid: Dictionary = {"version":2,"state":GameState.to_dict(),"player":PlayerController.snapshot(),"dialogue":{}}
	for change: Array in [["version",999],["state",{"current_area":"invalid"}],["player",{"area":"reception","position":[0,"bad"]}],["dialogue",{"choices":"bad"}]]:
		var invalid: Dictionary = valid.duplicate(true)
		invalid[change[0]]=change[1]
		check("reject_"+change[0],not SaveManager._valid_payload(invalid))
	var legacy: Dictionary=valid.duplicate(true)
	legacy["version"]=1
	legacy.erase("player")
	legacy.erase("dialogue")
	check("legacy_v1",SaveManager._valid_payload(legacy))
	SubareaManager._open_receptionist_dialogue()
	check("dialogue_save",SaveManager.save_slot(96))
	DialogueUI.close_dialogue()
	SaveManager.load_slot(96)
	await frames()
	check("dialogue_restored",DialogueUI.current_dialogue_id=="receptionist_intro")
	DialogueUI.close_dialogue()
	DialogueUI.show_speech("Teste","Esta fala deve permanecer disponível durante a pausa.")
	MenuUI.open_pause()
	var remaining: float=DialogueUI.speech_remaining
	await frames(20)
	check("speech_pause",is_equal_approx(remaining,DialogueUI.speech_remaining))
	MenuUI.close_all()
	SettingsManager.set_value("manual_dialogue",true)
	await frames(20)
	check("manual_speech",DialogueUI.speech_layer!=null)
	SettingsManager.set_value("manual_dialogue",false)
	DialogueUI.close_speech()
	MenuUI.inventory_selected_id="vr_glasses"
	MenuUI.open_inventory()
	check("stale_item_cleared",MenuUI.inventory_selected_id=="" or GameState.has_item(MenuUI.inventory_selected_id))
	MenuUI.close_all()
	ExperienceUI.open_journal()
	check("journal_modal",ExperienceUI.is_open() and InteractionGuard.modal_blocked())
	ExperienceUI.close()
	SettingsManager.set_value("font_scale",1.3)
	check("font_scale",SettingsManager.font_size(20)==26)
	SettingsManager.set_value("font_scale",1.0)
	check("music_resource",ResourceLoader.exists(MusicManager.INNOVATION_TI_AUDIO_PATH))
	SaveManager.delete_slot(95)
	SaveManager.delete_slot(96)

extends "res://scripts/main.gd"
var checks: Array = []
var ending: String = ""
func _ready() -> void:
	super._ready()
	GameFlow.finished.connect(func(name: String,_message: String): ending=name)
	call_deferred("run_checks")
func check(name: String,passed: bool) -> void:
	checks.append({"check":name,"passed":passed})
	print("QA ",JSON.stringify(checks[-1]))
func frames(count: int = 5) -> void:
	for i: int in range(count): await get_tree().process_frame
func fresh(area: String = "reception") -> void:
	EndingUI._close_overlay()
	MenuUI.close_all()
	ExperienceUI.close()
	_new_game()
	SceneRouter.route_to(area)
	ending = ""
	await frames()
func act(id: String,item: String = "") -> void:
	GameFlow.perform(id,item)
func choose(id: String) -> void:
	DialogueUI._select(DialogueUI.current_dialogue_id,id)

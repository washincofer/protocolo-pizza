func geometry_checks() -> void:
	var Hotspots = preload("res://scripts/hotspot_catalog.gd")
	var Walkable = preload("res://scripts/walkable_catalog.gd")
	for area: String in Hotspots.BACKGROUNDS:
		if area=="menu": continue
		await fresh(area)
		check("area_"+area,ResourceLoader.exists(Hotspots.BACKGROUNDS[area]))
		var valid: bool=true
		for hs: Dictionary in Hotspots.get_hotspots(area):
			var r: Array=hs["rect"]
			valid=valid and r[0]>=0 and r[1]>=0 and r[0]+r[2]<=1672 and r[1]+r[3]<=941
		check("bounds_"+area,valid)
		var floor_rect: Rect2=Walkable.bounds(area)
		var path: PackedVector2Array=Walkable.path(area,floor_rect.position+Vector2(10,10),floor_rect.end-Vector2(10,10))
		valid=not path.is_empty()
		for i: int in range(path.size()-1): valid=valid and Walkable.clear_segment(area,path[i],path[i+1])
		check("walk_"+area,valid)
	await fresh()
	var world_button: Button=null
	for child: Node in get_children():
		if child is Button and child.get_meta("world_hotspot",false):
			world_button=child
			break
	check("keyboard_world_focus",world_button!=null and world_button.focus_mode==Control.FOCUS_ALL)
	MenuUI.open_pause()
	await frames()
	check("keyboard_modal_blocks_world",world_button.focus_mode==Control.FOCUS_NONE)
	MenuUI.close_all()

func input_checks() -> void:
	await fresh()
	SettingsManager.set_value("reduced_motion",true)
	var receptionist: Button=null
	for child: Node in get_children():
		if child is Button and child.get_meta("world_hotspot",false) and child.tooltip_text=="Balcão da Recepção": receptionist=child
	check("reception_button_available",receptionist!=null)
	if receptionist!=null:
		receptionist.grab_focus()
		var key: InputEventKey=InputEventKey.new()
		key.keycode=KEY_ENTER
		key.pressed=true
		Input.parse_input_event(key)
		await frames(2)
		key.pressed=false
		Input.parse_input_event(key)
		await frames()
		check("keyboard_opens_reception_dialogue",DialogueUI.current_dialogue_id=="receptionist_intro")
		choose("A")
		check("keyboard_dialogue_progress",GameState.has_flag("identified"))
	await fresh()
	var label: String="Balcão da Recepção"
	var button: Button=null
	for child: Node in get_children():
		if child is Button and child.get_meta("world_hotspot",false) and child.tooltip_text==label: button=child
	if button!=null:
		var point: Vector2=button.global_position+button.size*0.5
		var motion: InputEventMouseMotion=InputEventMouseMotion.new()
		motion.position=point
		motion.global_position=point
		get_viewport().push_input(motion,true)
		await frames(2)
		var mouse: InputEventMouseButton=InputEventMouseButton.new()
		mouse.position=point
		mouse.global_position=point
		mouse.button_index=MOUSE_BUTTON_LEFT
		mouse.pressed=true
		get_viewport().push_input(mouse,true)
		await frames(2)
		mouse.pressed=false
		get_viewport().push_input(mouse,true)
		await frames()
		check("mouse_opens_reception_dialogue",DialogueUI.current_dialogue_id=="receptionist_intro")
	SettingsManager.set_value("reduced_motion",false)
